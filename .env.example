# Supabase — obtenha em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para uso em rotas/servidor administrativas (nunca expor ao cliente)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em redirects de auth, ex.: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Opcional: e-mail exibido em /termos e /privacidade como canal de contato/LGPD
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Opcional: sal para pseudonimizar IPs no rate limit (qualquer texto aleatório)
RATE_LIMIT_SALT=
